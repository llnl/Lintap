# Environment overrides for the Lintap systemd service.
# This file is sourced by systemd, not a shell; use KEY=VALUE assignments.

# Shared, archivable event data. This directory directly contains raw_sensor/.
# Keep it suitable for a shared mount; host-local state belongs in runtime.
WINTAP_DATA_ROOT=/var/log/lintap/data
# Host-local logs, DuckDB, diagnostics, recordings, and pidstat spool.
WINTAP_RUNTIME_ROOT=/var/log/lintap/runtime

# Keep optional native-heavy UI/MCP paths disabled during Linux sensor validation.
WINTAP_DISABLE_MCP=true
WINTAP_DISABLE_DUCKDB_UI=true

# Enable normal ETL and Linux sensor manager.
WINTAP_DISABLE_ETL=false
WINTAP_DISABLE_SENSORS=false

# Stable Linux sensors validated during Fedora/RHEL bring-up.
WINTAP_ENABLE_EXECVE_SENSOR=true
WINTAP_ENABLE_EXIT_SENSOR=true
WINTAP_ENABLE_NETWORK_SENSOR=true
WINTAP_ENABLE_FILEOPS_SENSOR=true
WINTAP_ENABLE_PROCESS_RUNDOWN_SENSOR=true

# Capture fork-only processes by default. Set false for explicit opt-out.
WINTAP_ENABLE_CLONE_SENSOR=true

# Debian keeps the application default Snappy compression. Ubuntu's glibc
# satisfies libnironcompress.so, unlike the RHEL 8 field packaging target.

# Keep optional native-heavy UI/MCP paths disabled during Linux sensor validation.
WINTAP_DISABLE_MCP=true
WINTAP_DISABLE_DUCKDB_UI=true

# Enable normal ETL and Linux sensor manager.
WINTAP_DISABLE_ETL=false
WINTAP_DISABLE_SENSORS=false

# Stable Linux sensors validated during Fedora/RHEL bring-up.
WINTAP_ENABLE_EXECVE_SENSOR=true
WINTAP_ENABLE_EXIT_SENSOR=true
WINTAP_ENABLE_NETWORK_SENSOR=true
WINTAP_ENABLE_FILEOPS_SENSOR=true
WINTAP_ENABLE_PROCESS_RUNDOWN_SENSOR=true

# Capture fork-only processes by default. Set false for explicit opt-out.
WINTAP_ENABLE_CLONE_SENSOR=true

# Debian keeps the application default Snappy compression. Ubuntu's glibc
# satisfies libnironcompress.so, unlike the RHEL 8 field packaging target.

# Managed pidstat collector defaults. The collector reads the same environment
# file as the sensor service.
PIDSTAT_INTERVAL_SEC=5
PIDSTAT_ROTATE_INTERVAL_SEC=300
PIDSTAT_MIN_ROTATE_INTERVAL_SEC=300
PIDSTAT_DUCKDB_THREADS=1
PIDSTAT_MAX_UNSHIPPED_BYTES=1073741824
PIDSTAT_MAX_UNSHIPPED_AGE_SEC=0
PIDSTAT_VENV_DIR=/opt/lintap/pidstat-collector/.venv
PIDSTAT_BOOTSTRAP_PYTHON=3.12

# Optional .NET runtime tuning. Uncomment if needed.
# DOTNET_GCHeapHardLimit=
# DOTNET_EnableDiagnostics=0
